# Backend origin for REST calls (no trailing slash). Public, non-secret.
VITE_API_BASE_URL=https://hiring-dev.internal.kloudspot.com
# Socket.IO origin. Defaults to VITE_API_BASE_URL when omitted.
VITE_SOCKET_URL=https://hiring-dev.internal.kloudspot.com

# --- E2E only (never prefixed with VITE_, never bundled) ---
# Staging account for tests/e2e/staging.spec.ts. Set in your shell or CI secrets, not in a committed file.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_BASE_URL=   # optional: run e2e against a deployed URL instead of a local build
